# Google Gemini AI Configuration
# ==============================
# 1. Get your API key from: https://aistudio.google.com/apikey
# 2. Place your key below (do not commit real keys to version control!)
GEMINI_API_KEY=your_google_gemini_api_key_here

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/finwise

# Google Sheets Integration (optional)
SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/XXX/exec

# Force Delay Simulation (for development/testing)
FORCE_API_DELAY=true